{
  "manifest_version": 3,
  "name": "AetherUI",
  "description": "Freemium AI design intelligence platform for analyzing interfaces, generating premium prompts, and exporting to modern AI tools.",
  "version": "0.1.0",
  "action": {
    "default_title": "AetherUI",
    "default_popup": "index.html"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
